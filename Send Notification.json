        "jsCode": "const headers = $input.first().json.headers || {};\nconst body = $input.first().json.body || {};\nconst expected = $env.N8N_NOTIFY_SHARED_SECRET || '';\nconst provided = headers['x-notify-secret'] || headers['X-Notify-Secret'] || '';\n\nif (!expected || provided !== expected) {\n  return [{ json: { ok: false, status: 401, error: 'Unauthorized' } }];\n}\n\nconst phone = String(body.phone || '').trim();\nconst message = String(body.message || '').trim();\nif (!phone || !message) {\n  return [{ json: { ok: false, status: 400, error: 'phone and message are required' } }];\n}\n\nreturn [{ json: { ok: true, phone, message } }];\n"
      },
      "id": "f5765044-e55e-48c4-b120-c6f238685696",
