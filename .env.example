# Copy this file to .env and replace every placeholder with your real local value.
# Do not put these values in workflow JSON files. Do not commit .env.

# WhatsApp API — used by Send WhatsApp Reply (credential type: whatsAppApi)
# Sync into n8n with: python3 scripts/apply-whatsapp-auth.py
# Do NOT paste tokens into workflow JSON. Configure in n8n → Credentials after sync.
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id

# WhatsApp OAuth — used by WhatsApp Trigger (credential type: whatsAppTriggerApi)
WHATSAPP_CLIENT_ID=your-meta-app-id
WHATSAPP_CLIENT_SECRET=your-meta-app-secret

# OpenAI — used by OpenAI Chat Model (credential type: openAiApi)
OPENAI_API_KEY=your-openai-api-key

# SMTP — used by Email Admin (credential type: smtp)
SMTP_USER=you@example.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Clinic timezone for appointment display (Pakistan Standard Time).
# n8n Code nodes currently hardcode this same value; keep them in sync.
CLINIC_TIMEZONE=Asia/Karachi


# Supabase (local clinic desk) — used by Book/Cancel/Reschedule/Get/Availability/Search tools
# Copy service role from `npx supabase status` in Dentalclinic-dashboard. Never commit real keys.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public tunnel URL for WhatsApp Trigger (Meta must reach n8n).
# Do NOT hardcode a trycloudflare.com URL — it changes every tunnel start.
# ./start-n8n-whatsapp.sh auto-detects the URL and writes WEBHOOK_URL here.

# When n8n runs in Docker: copy these into .env.docker with
# SUPABASE_URL=http://host.docker.internal:54321, then:
#   ./start-n8n-whatsapp.sh
# Never set CREDENTIALS_OVERWRITE_ENDPOINT unless you host n8n's credentials REST endpoint.
# start-n8n.sh injects CREDENTIALS_OVERWRITE_DATA only (from WHATSAPP_* in .env.docker).
# Allow expressions to read env vars:
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_PROXY_HOPS=1
