# Copy to .env on the Oracle VM (same directory as docker-compose.prod.yml).
#   cp .env.production.example .env && chmod 600 .env
# Never commit .env. Do NOT set N8N_ENCRYPTION_KEY — it lives inside the n8n_data volume.

# --- Public URL (DuckDNS) — trailing slash on WEBHOOK_URL / N8N_EDITOR_BASE_URL ---
N8N_HOST=smilecare-n8n.duckdns.org
N8N_PROTOCOL=https
N8N_SECURE_COOKIE=true
WEBHOOK_URL=https://smilecare-n8n.duckdns.org/
N8N_EDITOR_BASE_URL=https://smilecare-n8n.duckdns.org/
N8N_PROXY_HOPS=1

# Tool workflows use {{ $env.SUPABASE_* }} — must stay false
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# --- Execution data (patient privacy) ---
# Executions store full WhatsApp messages, patient names and phone numbers.
# Keep only failed runs, and delete everything older than 3 days.
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=72

# --- Supabase Cloud (same project as Vercel) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-cloud-service-role-key

# --- Timezone ---
TZ=Asia/Karachi
CLINIC_TIMEZONE=Asia/Karachi

# --- WhatsApp sender profile (REQUIRED — read by the workflows via $env) ---
# REAL profile: the clinic's registered number only. Phone Number IDs, not phone numbers.
# Production must NOT list the Meta test number — local dev owns that one.
WHATSAPP_PHONE_NUMBER_ID=your-real-phone-number-id
WHATSAPP_ALLOWED_PHONE_NUMBER_IDS=your-real-phone-number-id

# --- WhatsApp (only needed if you re-sync credentials with apply-whatsapp-auth.py) ---
# Production uses its OWN Meta app ("Appointment Syatem", App ID 1755561068820381),
# separate from local dev's "Appointment Syatem Local" — one webhook callback per app.
# The token must be a System User token generated FOR the production app
# (expiry Never, whatsapp_business_messaging + whatsapp_business_management).
WHATSAPP_ACCESS_TOKEN=your-system-user-or-long-lived-token
WHATSAPP_BUSINESS_ACCOUNT_ID=your-real-waba-id
WHATSAPP_CLIENT_ID=your-production-meta-app-id
WHATSAPP_CLIENT_SECRET=your-production-meta-app-secret

# --- Optional: SMTP for WhatsApp Booking Error Handler ---
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true

# DO NOT ADD:
# N8N_ENCRYPTION_KEY=...
# DB_TYPE=postgresdb
# OPENAI_API_KEY=...   (unused — Groq credential is inside the volume)
