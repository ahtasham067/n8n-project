# Copy to .env next to docker-compose.queue.yml:  cp .env.queue.example .env && chmod 600 .env
# Never commit .env.

# --- Queue mode: Postgres, Redis and the shared encryption key ---------------
# Generate each with: openssl rand -hex 24
N8N_DB_PASSWORD=change-me
REDIS_PASSWORD=change-me
# Every n8n process must use the same key. When moving from the SQLite
# deployment, migrate-sqlite-to-queue.sh copies the key from the old volume's
# config file into this .env; don't invent a new one or saved credentials
# can't be decrypted.
N8N_ENCRYPTION_KEY=
# Executions each worker runs at once (n8n recommends at least 5).
N8N_WORKER_CONCURRENCY=8
N8N_MAIN_PORT=5678

# --- Public URL (trailing slash on WEBHOOK_URL / N8N_EDITOR_BASE_URL) --------
N8N_HOST=n8n.clinidesk.online
N8N_PROTOCOL=https
N8N_SECURE_COOKIE=true
WEBHOOK_URL=https://n8n.clinidesk.online/
N8N_EDITOR_BASE_URL=https://n8n.clinidesk.online/
N8N_PROXY_HOPS=1

# Tool workflows read {{ $env.SUPABASE_* }} and {{ $env.CLINIDESK_* }}.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# --- Execution data (patient privacy) ----------------------------------------
# Executions hold WhatsApp messages and phone numbers: keep failures only, 3 days.
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=72

N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
TZ=Asia/Karachi

# --- Supabase (the app database the tools call over REST) --------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- CliniDesk gateway ---------------------------------------------------------
# The dashboard posts every allowed WhatsApp message to POST /webhook/clinidesk-inbound;
# replies, voice notes and LLM calls go back through it. Must match the dashboard's
# CLINIDESK_GATEWAY_SECRET (it is also the API key of the "CliniDesk LLM proxy" credential).
CLINIDESK_GATEWAY_URL=https://app.clinidesk.online
CLINIDESK_GATEWAY_SECRET=your-gateway-secret
# CliniDesk Scheduler workflow: calls the dashboard's /api/cron/platform-alerts
# every 15 minutes (Vercel Hobby runs crons only daily). Same value as
# CRON_SECRET in the dashboard.
CLINIDESK_CRON_SECRET=your-cron-secret

# Caddy (docker compose --profile tls) reads this hostname.
CADDY_HOST=n8n.clinidesk.online
