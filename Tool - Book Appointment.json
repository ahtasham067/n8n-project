{
  "name": "Tool - Book Appointment",
  "id": "vlxq9W4WX10a6sOt",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "clinic_id"
            },
            {
              "name": "phone_number"
            },
            {
              "name": "doctor_id"
            },
            {
              "name": "patient_name"
            },
            {
              "name": "appointment_date"
            },
            {
              "name": "appointment_time"
            }
          ]
        }
      },
      "id": "64060b98-c2c4-5a4c-94a9-de1ab02398c5",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/bot_book_appointment",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_clinic_id: $json.clinic_id, p_doctor_id: $json.doctor_id || null, p_date: $json.appointment_date, p_patient_name: $json.patient_name, p_phone: $json.phone_number, p_time: $json.appointment_time || null }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "5fc3e566-f4da-5fed-a98a-23d683e48170",
      "name": "RPC bot_book_appointment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        280,
        0
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "content": "## Book Appointment\nBooks the WhatsApp sender with a doctor on an hour window (the one asked for, or the earliest), refusing inactive or hidden doctors and asking first about a same-day, same-doctor, same-name duplicate (bot_book_appointment).",
        "height": 200,
        "width": 420
      },
      "id": "2bfd21c1-5fe2-50b2-89c4-d345d2c53969",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -240
      ]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "RPC bot_book_appointment",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "staticData": null,
  "pinData": {}
