{
  "name": "Tool - Check Doctor Availability",
  "id": "K3aQylfpGB7OIUmy",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "clinic_id"
            },
            {
              "name": "phone_number"
            },
            {
              "name": "doctor_id"
            },
            {
              "name": "preferred_date"
            }
          ]
        }
      },
      "id": "620e3976-f30e-5e90-89c4-2d2aa408a203",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/bot_doctor_availability",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_clinic_id: $json.clinic_id, p_doctor_id: $json.doctor_id || null, p_date: $json.preferred_date, p_phone: $json.phone_number }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "47734993-20f4-51d3-a5a3-b45292103038",
      "name": "RPC bot_doctor_availability",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        280,
        0
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "content": "## Check Doctor Availability\nOpen hour windows on a date, why there are none (leave, no hours, full), the next 3 dates with room and up to 2 same-specialty doctors free that day (bot_doctor_availability). A single-doctor clinic needs no doctor_id.",
        "height": 200,
        "width": 420
      },
      "id": "715f089a-6534-5f9b-a9c7-7e97dc2558c8",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -240
      ]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "RPC bot_doctor_availability",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "staticData": null,
  "pinData": {}
}
