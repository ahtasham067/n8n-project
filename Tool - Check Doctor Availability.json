{
  "name": "Tool - Check Doctor Availability",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            { "name": "doctor_id" },
            { "name": "preferred_date" }
          ]
        }
      },
      "id": "29085e7b-69aa-47a6-985e-b8bf336e31cc",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/get_available_slots",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "={{ 'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_clinic_id: $env.CLINIC_ID || 'CLINIC-SMILECARE', p_doctor_id: $json.doctor_id, p_date: $json.preferred_date }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "rpc-get-available-slots",
      "name": "RPC get_available_slots",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [280, 0],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const trigger = $('Execute Workflow Trigger').first().json;\nconst rpc = $input.first().json;\n\nif (rpc.error || rpc.code) {\n  return [{ json: {\n    success: false,\n    error_type: 'database_failure',\n    message: 'Sorry, I am having trouble checking appointment availability right now. Please try again in a few minutes.'\n  } }];\n}\n\nreturn [{ json: {\n  success: rpc.success !== false,\n  doctor_id: trigger.doctor_id,\n  doctor_name: rpc.doctor_name,\n  date: trigger.preferred_date,\n  timezone: rpc.timezone,\n  available_slots: rpc.available_slots || [],\n  available_slots_display: rpc.available_slots_display || [],\n  booked_slots: rpc.booked_slots || [],\n  message: rpc.message\n} }];"
      },
      "id": "a1557c55-08c9-4bc2-b503-ce02cdb00f52",
      "name": "Format RPC Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [560, 0]
    },
    {
      "parameters": {
        "content": "## Tool: Check Doctor Availability\nCalls Postgres RPC get_available_slots (booked-slot exclusion in DB). Set CLINIC_ID env per deployment.",
        "height": 200,
        "width": 320
      },
      "id": "3af1c768-c753-423f-95e9-da40651bf4d4",
      "name": "Sticky Note aff4940b",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [0, -260]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [[{ "node": "RPC get_available_slots", "type": "main", "index": 0 }]]
    },
    "RPC get_available_slots": {
      "main": [[{ "node": "Format RPC Response", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate",
    "availableInMCP": true,
    "timeSavedMode": "fixed",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "staticData": null,
  "pinData": {}
}
