            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_clinic_id: $json.clinic_id, p_phone: $json.phone_number, p_appointment_id: $json.appointment_id, p_new_date: $json.new_date, p_new_time: $json.new_time || null, p_new_doctor_id: $json.new_doctor_id || null }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "703fab5b-43ca-5d72-a146-7f6d89c50667",
      "name": "RPC bot_reschedule",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        280,
        0
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "content": "## Reschedule Appointment\nMoves the sender's own appointment on hourly windows, optionally to another doctor (bot_reschedule). Replaces the old version, which validated against legacy working days and hours.",
